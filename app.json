{
  "expo": {
    "name": "FarmOS",
    "slug": "farmos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/FarmOS-plow-blade-icon-adaptive-foreground.png",
    "scheme": "farmos",
    "userInterfaceStyle": "light",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/c6867146-4602-4824-a6b6-cbe11580db8a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E7E5E1",
        "foregroundImage": "./assets/images/FarmOS-plow-blade-icon-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/FarmOS-plow-blade-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-background-task",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c6867146-4602-4824-a6b6-cbe11580db8a"
      }
    },
    "owner": "mooahmads-team"
  }
}
