# Copy to `.env.development`, `.env.preview`, `.env.production` and fill in.
# app.config.ts loads `.env.<APP_ENV>` first, then `.env` for shared defaults.
# APP_ENV is provided by the EAS build profile (see eas.json) or your shell.

# Base URL of the FarmOS ASP.NET Core API.
# Note: on the Android emulator, host "localhost" is the emulator itself —
# use http://10.0.2.2:<port> (or your machine's LAN IP) to reach a dev API.
API_BASE_URL=https://localhost:7229

# Sentry DSN (leave empty to disable crash reporting locally).
SENTRY_DSN=

# EAS project id (filled in by `eas init`).
EAS_PROJECT_ID=
